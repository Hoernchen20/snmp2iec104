%% Gateway configuration inside the container image (replaces the release's
%% config/sys.config). Paths are relative to /opt/snmp2iec104; data/ and
%% etc/ are volumes. Ports here are container ports: compose.yaml decides
%% which host addresses and ports they are published on.
[
    {kernel, [
        {logger_level, info}
    ]},
    {mnesia, [
        {dir, "data/mnesia"}
    ]},
    {s2i_core, [
        {secret_key_file, "etc/secret.key"}
    ]},
    %% Docker lets unprivileged processes bind ports < 1024 in a container's
    %% own network namespace, so the non-root user can use port 162 here.
    %% (With network_mode: host that does not apply: use a port >= 1024.)
    {s2i_snmp, [
        {dir, "data/snmp"},
        {ip, "0.0.0.0"},
        {port, 162}
    ]},
    %% Plain HTTP; put a TLS proxy in front, or mount a certificate into
    %% etc/ and enable https, before exposing the UI beyond a test machine.
    %% Admin bootstrap: $S2I_ADMIN_PASSWORD, else a random password in
    %% data/initial_admin_password.
    {s2i_web, [
        {http, [{ip, "0.0.0.0"}, {port, 8080}]}
    ]}
].
