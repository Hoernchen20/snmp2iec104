%% -*- erlang -*-

{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_import,
    warn_unused_vars,
    warn_export_vars,
    warn_untyped_record
]}.

{deps, [
    {iec60870, {git_subdir, "https://github.com/Hoernchen20/erl60870.git",
                {tag, "v0.2.0"}, "apps/iec60870"}},
    %% cowboy 2.13+ declares its cowlib range as ">= 2.14.0 and < 3.0.0",
    %% which rebar3 3.25 cannot parse; stay on 2.12 until that is fixed.
    {cowboy, "2.12.0"},
    %% Pinned at top level so it wins over cowboy's ranch 1.x requirement;
    %% erl60870 needs ranch 2.x and cowboy 2.x supports it.
    {ranch, "2.2.0"}
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, unknown]},
    {plt_apps, all_deps},
    {plt_extra_apps, [ssl, snmp, mnesia, crypto, common_test]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]},
        {deps, [{proper, "1.4.0"}]}
    ]}
]}.

{relx, [
    {release, {snmp2iec104, "0.1.0"}, [snmp2iec104, sasl]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [snmp2iec104]}
]}.

%% Same split as erl60870: ct runs on its own (CI does every step separately).
{alias, [
    {check, [compile, eunit, xref, dialyzer]}
]}.
