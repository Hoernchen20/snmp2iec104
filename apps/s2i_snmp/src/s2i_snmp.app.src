{application, s2i_snmp, [
    {description, "snmp2iec104: SNMP manager side (polling, traps)"},
    {vsn, "0.1.0"},
    {registered, [s2i_snmp_sup, s2i_devices_sup, s2i_snmp_mgr]},
    {applications, [
        kernel,
        stdlib,
        crypto,
        snmp,
        s2i_core,
        s2i_iec
    ]},
    {env, [
        %% snmpm config and database
        {dir, "data/snmp"},
        %% one UDP socket for requests, responses, traps and informs;
        %% port 162 needs CAP_NET_BIND_SERVICE or a port redirect
        {ip, "0.0.0.0"},
        {port, 162},
        %% hex snmpEngineID of the gateway; generated once into <dir>/engine_id if unset
        {engine_id, undefined}
    ]},
    {modules, []}
]}.
