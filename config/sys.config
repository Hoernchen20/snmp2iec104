[
    {kernel, [
        {logger_level, info}
    ]},
    %% Relative to the release root (the start script runs from there).
    {mnesia, [
        {dir, "data/mnesia"}
    ]},
    %% Key for the SNMP secrets in Mnesia: keep it outside data/ and back it
    %% up separately (e.g. /etc/snmp2iec104/secret.key, mode 0600).
    {s2i_core, [
        {secret_key_file, "etc/secret.key"}
    ]},
    %% SNMP manager: one UDP socket for polling and for traps/informs.
    %% Port 162 needs CAP_NET_BIND_SERVICE (or a redirect, e.g. nftables
    %% 162 -> 1162). engine_id: hex snmpEngineID of the gateway, generated
    %% once into data/snmp/engine_id when unset (needed for v3 informs).
    {s2i_snmp, [
        {dir, "data/snmp"},
        {ip, "0.0.0.0"},
        {port, 162}
    ]},
    %% Web UI / REST API. Plain HTTP only on localhost by default; for remote
    %% access enable https (session cookies are marked Secure on https).
    %% Bootstrap admin (only when there are no users): password from
    %% $S2I_ADMIN_PASSWORD, else admin_password, else generated into
    %% initial_password_file; it must be changed on first login.
    {s2i_web, [
        {http, [{ip, "127.0.0.1"}, {port, 8080}]}
        %% ,{https, [{ip, "0.0.0.0"}, {port, 8443},
        %%           {certfile, "etc/web.crt"}, {keyfile, "etc/web.key"}]}
    ]}
].
