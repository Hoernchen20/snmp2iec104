[
    {kernel, [
        {logger_level, info}
    ]},
    %% Relative to the release root (the start script runs from there).
    {mnesia, [
        {dir, "data/mnesia"}
    ]},
    %% Key for the SNMP secrets in Mnesia: keep it outside data/ and back it
    %% up separately (e.g. /etc/snmp2iec104/secret.key, mode 0600).
    {s2i_core, [
        {secret_key_file, "etc/secret.key"}
    ]}
].
